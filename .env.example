# OpenMan configuration. Copy to .env.local (git-ignored) and fill in:
#   cp .env.example .env.local && node scripts/setup.mjs
# scripts/setup.mjs generates the four app secrets for you and checks the required values.
# Every value is read on the server only, except names starting with NEXT_PUBLIC_, which are compiled into browser code.
# Never commit a filled-in copy of this file.

# =====================================================================================================================
# Required
# =====================================================================================================================

# Public origin of this deployment, no trailing slash. Used for sign-in return URLs, links in emails and webhooks.
APP_PUBLIC_URL=http://localhost:3000

# Supabase project (Project Settings -> API). The app talks to it only from the server, with the publishable key plus
# the APP_DB_SECRET header; browsers never query it. Do not use the service-role key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# PostgreSQL schema containing the app tables. Leave unset for a standalone installation.
APP_DB_SCHEMA=
# Server-only gateway API key for shared installations.
APP_DB_API_KEY=
# Server-only JWT for the dedicated Mahara database role.
APP_DB_ACCESS_TOKEN=

# App secrets: 64 hex characters each (32 random bytes), one set per environment. Generate with
# `node scripts/setup.mjs` or `openssl rand -hex 32`. Keep them out of logs and never reuse them across environments.
# Shared secret the server sends to the database; its SHA-256 must be stored in private.server_secret (setup prints the SQL).
APP_DB_SECRET=
# Key for the session cookie. Rotating it signs everyone out.
SESSION_SECRET=
# AES-256-GCM key for secrets stored per user (Orgo key, agent key, connector secrets). Rotating it makes them unreadable.
APP_ENCRYPTION_KEY=
# Bearer token for POST /api/cron/tick (the scheduler worker) and GET /api/health/deep.
CRON_SECRET=

# =====================================================================================================================
# Local development only (ignored when NODE_ENV=production)
# =====================================================================================================================

# 1 = skip sign-in and use a local development user built from the values below. `npm run dev` and loopback
# requests only; a production server with it set refuses to start. (Replaces the old NEXT_PUBLIC_AUTH_DISABLED.)
OPENMAN_DEV_BYPASS=
# 1 = offer "Sign in with this computer's Orgo key" (uses ORGO_API_KEY below). For running OpenMan on your own machine
# only: offered when the server listens on 127.0.0.1 (`npm run dev`, or `npm start -- -H 127.0.0.1`), APP_PUBLIC_URL is
# unset or loopback, and the request comes from this machine. Works in production builds; a public APP_PUBLIC_URL
# with it set stops the server from starting.
OPENMAN_LOCAL_SIGNIN=
# Your Orgo API key (orgo.ai/api-keys, or `orgo keys create --name OpenMan`) and workspace id, for the development user
# and local sign-in.
ORGO_API_KEY=
ORGO_WORKSPACE_ID=
# The development user's agent computer: its Orgo computer id and the Hermes API server on it.
ORGO_COMPUTER_ID=
HERMES_BASE_URL=
HERMES_API_KEY=
# Optional for the development user: a fixed live-desktop websocket URL (normally fetched per session from Orgo),
# a fallback computer password, the screen size, and whether the desktop view is watch-only (default true).
ORGO_VNC_URL=
ORGO_COMPUTER_PASSWORD=
ORGO_SCREEN_WIDTH=1280
ORGO_SCREEN_HEIGHT=720
ORGO_VNC_VIEW_ONLY=true
# Where local task files and caches are kept (default ./.data).
OPENMAN_DATA_DIR=
# Speed multiplier for the built-in mock agent, which plays scripted runs while HERMES_BASE_URL is unset (e.g. 5).
OPENMAN_MOCK_SPEED=

# =====================================================================================================================
# Optional integrations. Each feature stays hidden or reports "not configured" until its values are set.
# These vendors are paid by the operator of this deployment, not by the user's Orgo credits; per-user caps apply
# (src/config/usage-limits.ts, override with USAGE_LIMITS below).
# =====================================================================================================================

# --- Agent email (AgentMail): an inbox per user, email-triggered tasks and automations --------------------------------
AGENTMAIL_API_KEY=
# Signing secret of the webhook you register for this app (Svix). Inbound mail is refused without it.
AGENTMAIL_WEBHOOK_SECRET=
# Pod that holds this app's inboxes (empty: find or create one named "openman").
AGENTMAIL_POD_ID=
# Verified custom domain for agent addresses (empty: AgentMail's default domain).
AGENTMAIL_DOMAIN=
# API base URL override (default https://api.agentmail.to).
AGENTMAIL_BASE_URL=
# 1 = let automations start from inbound email.
AUTOMATION_EMAIL_INBOUND=

# --- Agent phone (AgentPhone): a number per user for SMS and calls ----------------------------------------------------
AGENTPHONE_API_KEY=
# Signing secret of the webhook you register for this app. Inbound texts and calls are refused without it.
AGENTPHONE_WEBHOOK_SECRET=
# Sub-account that owns this app's numbers and webhooks. Phone stays off until it is set.
AGENTPHONE_SUB_ACCOUNT_ID=
# API base URL override (default https://api.agentphone.ai).
AGENTPHONE_BASE_URL=

# --- Voice, meeting notes, speech and sound effects (ElevenLabs) ------------------------------------------------------
ELEVENLABS_API_KEY=
# 1 = also offer music generation (needs a paid ElevenLabs plan).
ELEVENLABS_MUSIC=
# Model overrides (defaults: scribe_v2_realtime, scribe_v2, eleven_multilingual_v2).
ELEVENLABS_REALTIME_MODEL=
ELEVENLABS_STT_MODEL=
ELEVENLABS_TTS_MODEL=
# Whisper model for keyless transcription on the user's own computer (default: the agent's own setting, else "base").
VOICE_WHISPER_MODEL=

# --- Image and video generation --------------------------------------------------------------------------------------
# Not set here. The agent generates images and video on the user's own computer, with provider keys the user adds to
# ~/.hermes/.env there: images FAL_KEY, OPENAI_API_KEY, XAI_API_KEY or KREA_API_KEY; video XAI_API_KEY or FAL_KEY.

# =====================================================================================================================
# Operator settings (all optional)
# =====================================================================================================================

# Who may use this deployment.
# 1 = invite list: only people on the list in the database may enter; the first account to sign in owns the list
# and manages it at /app/admin. Recommended for any public deployment.
INVITE_GATE=
# Older, simpler gate: comma-separated emails allowed in (empty: everyone who signs in).
ALLOWED_EMAILS=
# Comma-separated Orgo user ids that may open /app/admin besides the invite-list owner.
OPERATOR_USER_IDS=

# Monitoring.
# https URL that receives alerts as a Slack-compatible JSON POST ({"text": "..."}).
OPS_ALERT_WEBHOOK_URL=
# Key for hashing user ids in logs (default: derived from SESSION_SECRET).
OPS_HASH_KEY=
# debug | info | warn | error (default info).
LOG_LEVEL=info

# Limits.
# Per-user caps for operator-paid vendors as JSON, overriding src/config/usage-limits.ts, e.g. {"sms":{"day":100,"month":1000}}
USAGE_LIMITS=
# Tasks that may run at once per user, 1-20 (default: by the size of the user's computer).
OM_MAX_CONCURRENT_TASKS=
# Days before an idle task's working folder is cleared from the user's computer, 1-365 (default 7).
OM_TASK_FOLDER_IDLE_DAYS=
# Public API requests per key per minute (default 120).
PUBLIC_API_RATE_LIMIT=
# Number of reverse proxies in front of the app that append to X-Forwarded-For (default 1). Used for sign-in rate limits.
TRUSTED_PROXY_HOPS=1

# Orgo endpoints (defaults https://www.orgo.ai and https://www.orgo.ai/api). Change only to point at another Orgo environment.
ORGO_ORIGIN=
ORGO_API_BASE=

# 1 = links to the brand's own help and docs site are live (otherwise they show a short "coming soon" note).
NEXT_PUBLIC_BRAND_SITE_LIVE=

# =====================================================================================================================
# Scheduler worker (scripts/worker.mjs). It reads CRON_SECRET above.
# =====================================================================================================================

# Base URL of the app the worker calls (set it to your app's URL).
APP_URL=http://localhost:3000
# Tick interval in milliseconds (default 60000).
WORKER_EVERY_MS=60000
